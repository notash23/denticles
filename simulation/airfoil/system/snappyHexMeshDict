FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      snappyHexMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

castellatedMesh true;
snap            true;
addLayers       true;


geometry 
{
    airfoil.stl
    {
        type distributedTriSurfaceMesh;
        name airfoil;
    }

    denticles.stl
    {
        type distributedTriSurfaceMesh;
        name denticles;
    }

    refinement1 {
        type searchableBox;
        min ( -0.200 -0.025 -0.200);
        max ( 0.400 0.025 0.200);
    }
    
    refinement.stl
    {
        type triSurfaceMesh;
        name refinement2;
    }
};


castellatedMeshControls
{
    maxLocalCells 5000000;
    maxGlobalCells 500000000;
    minRefinementCells 0;

    maxLoadUnbalance 0.10;

    nCellsBetweenLevels 3;
    
    features
    (
        {
            file "airfoil.eMesh";
            level 0;
        }

        {
            file "denticles.eMesh";
            level 0;
        }
    );

    refinementSurfaces
    {
        airfoil
        {
            level (7 7);
            patchInfo { type wall; }
        }

        denticles
        {
            level (10 10);
            patchInfo { type wall; }
        }
    }
    
    resolveFeatureAngle 30;

    
    refinementRegions
    {
        refinement1
        {
            mode inside;
            levels ((1.0 4));
        }

        refinement2
        {
            mode inside;
            levels ((1.0 7));
        }
    }

    limitRegions
    {
    }


    locationInMesh (-0.5 0 0);
    allowFreeStandingZoneFaces true;
}


snapControls
{
    nSmoothPatch 4;
    tolerance 2.0; // 2.0
    nSolveIter 100; // 50
    nRelaxIter 20; // 5
    nFeatureSnapIter 100; // 10
    
    implicitFeatureSnap false;
    explicitFeatureSnap true;
    multiRegionFeatureSnap false;

    strictRegionSnap true;
}


addLayersControls
{
    relativeSizes true;

    expansionRatio 1.07;
    finalLayerThickness 0.8;
    minThickness 0.000001;

    layers
    {
        airfoil
        {
            nSurfaceLayers 25;
        }

        denticles
        {
            nSurfaceLayers 20;
        }
    }
    nGrow -1;

    featureAngle 130;
    maxFaceThicknessRatio 0.5;
    nSmoothSurfaceNormals 1;
    nSmoothThickness 10;
    
    minMedialAxisAngle 90;
    maxThicknessToMedialRatio 0.3;
    nSmoothNormals 3;
    slipFeatureAngle 10;
    nRelaxIter 5;
    nBufferCellsNoExtrude 0;
    nLayerIter 50;
    nRelaxedIter 0;
}


meshQualityControls
{
    #include "meshQualityDict"

    minDeterminant 1e-8;

    relaxed
    {
        maxNonOrtho 75;
        minTetQuality -1e30;
        minTwist    -1;
    }

    nSmoothScale 4;
    errorReduction 0.75;
}

mergeTolerance 1e-6;

