FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      blockMeshDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

convertToMeters 0.001;

//These vertices define the block below. It envelopes the stl files. The block can be even bigger than the stl files
//Watch out if the stl files are created in mm or m!

vertices
(
    ( -100 -150 -50)1
    (  500 -150 -50)2
    (  500  150 -50)3
    ( -100  150 -50)4
    ( -100 -150  50)5
    (  500 -150  50)6
    (  500  150  50)7
    ( -100  150  50)8
);

blocks
(
    hex (0 1 2 3 4 5 6 7) (30 30 30) simpleGrading (1 1 1)//coarse grid - we will refine in snappyHexMeshDict
);

edges
(
);

boundary
(
    inlet
    {
        type patch;
        faces
        (
            (0 5 8 4)
        );
    }
    outlet
    {
        type patch;
        faces
        (
            (2 3 7 6)
        );
    }
    walls
    {
        type wall;
        faces
        (
            (1 2 6 5)
            (5 6 7 8)
            (4 8 7 3)
            (4 3 2 1)
        );
    }
);

