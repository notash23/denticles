FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      setFieldsDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

defaultFieldValues
(
    volVectorFieldValue U (1 0 0)
    volScalarFieldValue T 0
);

regions
(   
    sphereToCell
    {
        centre  (0 0 0);
        radius  2;
        fieldValues
        (
            volScalarFieldValue T 1
        );
    }
);


